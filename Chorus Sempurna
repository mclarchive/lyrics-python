create_background()

# SUBTLE MOVING RED LIGHT

light = canvas.create_oval(
    -250,
    100,
    300,
    510,
    fill="#110607",
    outline=""
)


def move_light(t=0):

    x = math.sin(t * 0.004) * W * 0.18
    y = math.cos(t * 0.003) * H * 0.08

    canvas.coords(
        light,
        -250 + x,
        100 + y,
        300 + x,
        510 + y
    )

    root.after(
        80,
        move_light,
        t + 1
    )

# RAIN

rain = []

for _ in range(95):

    rain.append({
        "x": random.uniform(0, W),
        "y": random.uniform(-H, H),
        "speed": random.uniform(2.0, 4.5),
        "length": random.uniform(8, 20),
        "width": random.choice([1, 1, 1, 2]),
        "opacity": random.random(),
        "id": None
    })


def animate_rain():

    for drop in rain:

        drop["y"] += drop["speed"]

        # slight diagonal movement
        drop["x"] -= 0.35

        if drop["y"] > H + 25:

            drop["y"] = random.uniform(-80, -10)
            drop["x"] = random.uniform(0, W)

        if drop["x"] < -20:
            drop["x"] = W + 10

        if drop["id"] is not None:
            canvas.delete(drop["id"])

        # Keep rain subtle
        color = random.choice([
            "#241719",
            "#2C1A1C",
            "#382022",
            "#1D1214"
        ])

        drop["id"] = canvas.create_line(
            drop["x"],
            drop["y"],
            drop["x"] - 3,
            drop["y"] + drop["length"],
            fill=color,
            width=drop["width"]
        )

    root.after(
        35,
        animate_rain
    )

# AIR PARTICLES

particles = []

for _ in range(45):

    particles.append({
        "x": random.uniform(0, W),
        "y": random.uniform(0, H),
        "speed": random.uniform(0.08, 0.22),
        "drift": random.uniform(0.02, 0.08),
        "size": random.choice([
            0.5,
            0.7,
            1,
            1.2
        ]),
        "phase": random.uniform(
            0,
            math.tau
        ),
        "id": None
    })


def animate_particles(t=0):

    for p in particles:

        p["y"] -= p["speed"]

        p["x"] += (
            math.sin(
                t * 0.006 +
                p["phase"]
            ) * p["drift"]
        )

        if p["y"] < 0:
            p["y"] = H
            p["x"] = random.uniform(0, W)

        if p["id"] is not None:
            canvas.delete(p["id"])

        brightness = (
            math.sin(
                t * 0.018 +
                p["phase"]
            ) + 1
        ) / 2

        if brightness > 0.6:
            particle_color = "#432023"
        else:
            particle_color = "#211314"

        s = p["size"]

        p["id"] = canvas.create_oval(
            p["x"] - s,
            p["y"] - s,
            p["x"] + s,
            p["y"] + s,
            fill=particle_color,
            outline=""
        )

    root.after(
        55,
        animate_particles,
        t + 1
    )

# HEART

heart_x = W * 0.25
heart_y = H * 0.50
heart_size = 42


def draw_heart(cx, cy, size, color):

    points = []

    for i in range(101):

        t = math.pi * 2 * i / 100

        x = 16 * math.sin(t) ** 3

        y = (
            13 * math.cos(t)
            - 5 * math.cos(2 * t)
            - 2 * math.cos(3 * t)
            - math.cos(4 * t)
        )

        points.append((
            cx + x * size / 16,
            cy - y * size / 16
        ))

    flat = []

    for x, y in points:
        flat.extend([x, y])

    return canvas.create_polygon(
        flat,
        fill=color,
        outline=""
    )


heart = draw_heart(
    heart_x,
    heart_y,
    heart_size,
    RED
)

# HEART RINGS

rings = []

for multiplier in [1.25, 1.55, 1.85]:

    radius = heart_size * multiplier

    rings.append(
        canvas.create_oval(
            heart_x - radius,
            heart_y - radius,
            heart_x + radius,
            heart_y + radius,
            outline=RED_DARK,
            width=1
        )
    )


def pulse_heart(t=0):

    scale = 1 + math.sin(t) * 0.035

    canvas.delete(heart)

    globals()["heart"] = draw_heart(
        heart_x,
        heart_y,
        heart_size * scale,
        RED_LIGHT
    )

    for i, multiplier in enumerate(
        [1.25, 1.55, 1.85]
    ):

        canvas.delete(rings[i])

        subtle = (
            math.sin(t * 0.7 + i) + 1
        ) / 2

        radius = (
            heart_size * multiplier
            + subtle * 2
        )

        rings[i] = canvas.create_oval(
            heart_x - radius,
            heart_y - radius,
            heart_x + radius,
            heart_y + radius,
            outline=RED_DARK,
            width=1
        )

    root.after(
        50,
        pulse_heart,
        t + 0.10
    )

