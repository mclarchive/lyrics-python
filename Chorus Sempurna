# TEXT GLOW

def text_glow(t=0):

    k = (
        math.sin(t) + 1
    ) / 2

    r = int(220 + k * 10)
    g = int(213 + k * 7)
    b = int(210 + k * 5)

    label.config(
        fg=f"#{r:02x}{g:02x}{b:02x}"
    )

    root.after(
        80,
        text_glow,
        t + 0.035
    )

# TYPEWRITER

def typewriter():

    state = {
        "line": 0,
        "char": 0,
        "phase": "typing"
    }

    def step():

        li = state["line"]

        if li >= len(lyrics):
            root.destroy()
            return

        line, char_delay, hold_time = lyrics[li]

        # TYPING

        if state["phase"] == "typing":

            state["char"] += 1

            label.config(
                text=line[:state["char"]]
            )

            # finished
            if state["char"] >= len(line):

                # LAST LYRIC
                if li == len(lyrics) - 1:

                    label.config(
                        text=line
                    )

                    # stay for 2 seconds
                    root.after(
                        2000,
                        root.destroy
                    )

                    return

                state["phase"] = "hold"

                root.after(
                    int(hold_time * 1000),
                    step
                )

            else:

                root.after(
                    int(char_delay * 1000),
                    step
                )

        # NEXT LYRIc

        else:

            label.config(
                text=""
            )

            state["line"] += 1
            state["char"] = 0
            state["phase"] = "typing"

            root.after(
                180,
                step
            )

    step()

# START

move_light()
animate_rain()
animate_particles()
pulse_heart()
text_glow()

root.after(
    700,
    typewriter
)

root.mainloop()
